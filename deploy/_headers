# Cloudflare Workers (static assets). Lo que decide qué versión ve el usuario no
# se cachea en el navegador: la app, su service worker y el sello de versión.
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/version.json
  Cache-Control: no-store
/manifest.json
  Cache-Control: no-cache
/.well-known/assetlinks.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
